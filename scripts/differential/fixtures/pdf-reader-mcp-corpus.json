{
  "corpusVersion": 1,
  "description": "read_pdf + stdio transport differential corpus — frozen golden baseline via pdf-reader-cli oracle (rej-010)",
  "goldenFixture": "test/fixtures/read-pdf-golden.json",
  "transportContractCases": [
    {
      "id": "transport-default-stdio",
      "env": {},
      "expect": {
        "transport": "stdio"
      }
    },
    {
      "id": "transport-mcp-http",
      "env": {
        "MCP_TRANSPORT": "http"
      },
      "expect": {
        "transport": "http"
      }
    },
    {
      "id": "transport-pdf-reader-http",
      "env": {
        "PDF_READER_MCP_TRANSPORT": "http"
      },
      "expect": {
        "transport": "http"
      }
    },
    {
      "id": "transport-pdf-reader-precedence",
      "env": {
        "PDF_READER_MCP_TRANSPORT": "stdio",
        "MCP_TRANSPORT": "http"
      },
      "expect": {
        "transport": "stdio"
      }
    },
    {
      "id": "transport-ts-opt-in",
      "env": {
        "PDF_READER_MCP_TRANSPORT": "ts"
      },
      "expect": {
        "transport": "ts"
      }
    }
  ],
  "surfaceContractCases": [
    {
      "id": "surface-bin-rmcp",
      "surface": "bin",
      "markers": [
        "resolve_rust_bin",
        "resolve_transport",
        "exec \"$bin\"",
        "MCP_TRANSPORT=http"
      ]
    },
    {
      "id": "surface-stdio-rmcp",
      "surface": "stdio",
      "markers": [
        "transport::stdio",
        "http_transport::transport_from_env"
      ]
    }
  ],
  "toolRouteCases": [
    {
      "id": "route-read-pdf",
      "tool": "read_pdf",
      "expect": "RustCore"
    },
    {
      "id": "route-search-pdf",
      "tool": "search_pdf",
      "expect": "RustCore"
    },
    {
      "id": "route-pdf-evidence",
      "tool": "pdf_evidence",
      "expect": "RustCore"
    }
  ],
  "readPdfCases": [
    {
      "id": "tool-sample-metadata-on",
