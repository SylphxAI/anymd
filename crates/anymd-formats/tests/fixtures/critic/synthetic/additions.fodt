"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:13:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct20" text:id="ct20"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:20:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct21" text:id="ct21"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:27:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct22" text:id="ct22"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:34:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct23" text:id="ct23"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:41:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct24" text:id="ct24"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:48:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct25" text:id="ct25"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:55:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct26" text:id="ct26"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:02:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct27" text:id="ct27"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:09:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct28" text:id="ct28"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:16:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct29" text:id="ct29"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:23:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct30" text:id="ct30"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:30:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct31" text:id="ct31"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:37:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct32" text:id="ct32"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:44:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Heavy on additions</text:h>
   <text:p>The supplier may subcontract only with the<text:change-start text:change-id="ct1"/> on a business day<text:change-end text:change-id="ct1"/> buyer's prior consent.</text:p>
   <text:p><text:span text:style-name="I">Neither</text:span> party<text:change-start text:change-id="ct2"/> without undue delay<text:change-end text:change-id="ct2"/> is liable for <text:span text:style-name="B">delays</text:span> caused<text:change-start text:change-id="ct3"/> at its own cost<text:change-end text:change-id="ct3"/> <text:span text:style-name="B">by</text:span> events beyond its control.<text:change-start text:change-id="ct4"/></text:p>
   <text:p><text:change-end text:change-id="ct4"/><text:change-start text:change-id="ct5"/>The price includes packaging but excludes shipping and taxes.<text:change-end text:change-id="ct5"/></text:p>
   <text:p>The buyer may<text:change-start text:change-id="ct6"/> at its own cost<text:change-end text:change-id="ct6"/> inspect <text:span text:style-name="I">the</text:span> goods before<text:change-start text:change-id="ct7"/> in full<text:change-end text:change-id="ct7"/> accepting <text:span text:style-name="I">them</text:span>.</text:p>
   <text:p>Notices must be sent by email and by registered mail.</text:p>
   <text:p>Any change to this<text:change-start text:change-id="ct8"/> without undue delay<text:change-end text:change-id="ct8"/> agreement must <text:span text:style-name="B">be</text:span> in<text:change-start text:change-id="ct9"/> as reasonably required<text:change-end text:change-id="ct9"/> writing<text:change-start text:change-id="ct10"/> as reasonably required<text:change-end text:change-id="ct10"/> and signed by<text:change-start text:change-id="ct11"/> in good faith<text:change-end text:change-id="ct11"/> both <text:span text:style-name="B">parties</text:span>.</text:p>
   <text:p>The <text:span text:style-name="B">supplier</text:span><text:change-start text:change-id="ct12"/> unless agreed otherwise<text:change-end text:change-id="ct12"/> may <text:span text:style-name="B">subcontract</text:span> only<text:change-start text:change-id="ct13"/> promptly<text:change-end text:change-id="ct13"/> with the buyer's prior consent<text:change-start text:change-id="ct14"/> in good faith<text:change-end text:change-id="ct14"/>.</text:p>
   <text:p><text:span text:style-name="B">Late</text:span> payments carry interest at the<text:change-start text:change-id="ct15"/> in good faith<text:change-end text:change-id="ct15"/> statutory rate.<text:change-start text:change-id="ct16"/></text:p>
   <text:p><text:change-end text:change-id="ct16"/><text:change-start text:change-id="ct17"/>The price includes packaging but excludes shipping and taxes.<text:change-end text:change-id="ct17"/></text:p>
   <text:p>Either party may end this agreement with ninety <text:span text:style-name="B">days</text:span><text:change-start text:change-id="ct18"/> at its own cost<text:change-end text:change-id="ct18"/> written notice.<text:change-start text:change-id="ct19"/></text:p>
   <text:p><text:change-end text:change-id="ct19"/><text:change-start text:change-id="ct20"/>Each party keeps the other party's confidential information secret.<text:change-end text:change-id="ct20"/></text:p>
   <text:p>The warranty period is twelve months from <text:span text:style-name="B">delivery</text:span>.<text:change-start text:change-id="ct21"/></text:p>
   <text:p><text:change-end text:change-id="ct21"/><text:change-start text:change-id="ct22"/>The price includes packaging but excludes shipping and taxes.<text:change-end text:change-id="ct22"/></text:p>
   <text:p>The supplier shall deliver the goods within<text:change-start text:change-id="ct23"/> without undue delay<text:change-end text:change-id="ct23"/> thirty days <text:change-start text:change-id="ct25"/></text:p><text:p><text:change-end text:change-id="ct25"/>of the order<text:change-start text:change-id="ct24"/> at its own cost<text:change-end text:change-id="ct24"/>.</text:p>
   <text:p>Disputes go first to mediation and then to the courts of<text:change-start text:change-id="ct26"/> in full<text:change-end text:change-id="ct26"/> Manhattan.</text:p>
   <text:p>Payment is<text:change-start text:change-id="ct27"/> without undue delay<text:change-end text:change-id="ct27"/> due<text:change-start text:change-id="ct28"/> as reasonably required<text:change-end text:change-id="ct28"/> on<text:change-start text:change-id="ct29"/> in good faith<text:change-end text:change-id="ct29"/> receipt of a correct invoice<text:change-start text:change-id="ct30"/> promptly<text:change-end text:change-id="ct30"/>.</text:p>
   <text:p>The<text:change-start text:change-id="ct31"/> on a business day<text:change-end text:change-id="ct31"/> price includes<text:change-start text:change-id="ct32"/> at its own cost<text:change-end text:change-id="ct32"/> packaging but excludes shipping <text:span text:style-name="B">and</text:span> taxes.</text:p>
   <text:p><text:span text:style-name="B">Payment</text:span> is due <text:span text:style-name="B">on</text:span> receipt of a <text:span text:style-name="B">correct</text:span> invoice.</text:p>
  </office:text>
 </office:body>
