   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:07:00</dc:date></office:change-info><text:p><text:s/>with</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:14:00</dc:date></office:change-info><text:p><text:s/>end</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:21:00</dc:date></office:change-info><text:p><text:s/>written</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:28:00</dc:date></office:change-info><text:p>Either party may end this agreement with ninety days written notice.</text:p><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:35:00</dc:date></office:change-info><text:p><text:s/>on</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:42:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="B">carry</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:49:00</dc:date></office:change-info><text:p>The</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T