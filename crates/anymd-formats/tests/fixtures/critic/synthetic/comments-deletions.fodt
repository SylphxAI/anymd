   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:07:00</dc:date></office:change-info><text:p>The</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:14:00</dc:date></office:change-info><text:p><text:s/>the</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:21:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="B">goods</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:28:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="I">order</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:42:00</dc:date></office:change-info><text:p>Notices</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:56:00</dc:date></office:change-info><text:p><text:s/>then</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:03:00</dc:date></office:change-info><text:p><text:s/>to</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:10:00</dc:date></office:change-info><text:p><text:s/>the</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct9" text:id="ct9"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:31:00</dc:date></office:change-info><text:p><text:s/>party</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct10" text:id="ct10"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:45:00</dc:date></office:change-info><text:p><text:s/>laws</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct11" text:id="ct11"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:52:00</dc:date></office:change-info><text:p><text:s/>of</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct12" text:id="ct12"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:59:00</dc:date></office:change-info><text:p><text:s/>York</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:48:00</dc:date></office:change-info><text:p>The</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct14" text:id="ct14"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:55:00</dc:date></office:change-info><text:p><text:s/>the</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct15" text:id="ct15"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:02:00</dc:date></office:change-info><text:p><text:s/>days</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct16" text:id="ct16"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:16:00</dc:date></office:change-info><text:p><text:s/>price</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct17" text:id="ct17"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:30:00</dc:date></office:change-info><text:p><text:span text:style-name="I">Notices</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct18" text:id="ct18"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:37:00</dc:date></office:change-info><text:p><text:s/>must</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct19" text:id="ct19"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:51:00</dc:date></office:change-info><text:p><text:s/>receipt</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct20" text:id="ct20"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T04:12:00</dc:date></office:change-info><text:p><text:span text:style-name="B">Each</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct21" text:id="ct21"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T04:19:00</dc:date></office:change-info><text:p><text:s/>keeps</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct22" text:id="ct22"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T04:26:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="B">the</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct23" text:id="ct23"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T04:33:00</dc:date></office:change-info><text:p><text:s/>party's</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct24" text:id="ct24"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T04:40:00</dc:date></office:change-info><text:p><text:s/>secret</text:p></text:deletion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Comments and deletions</text:h>
   <text:p><text:change text:change-id="ct1"/><text:s/>supplier shall deliver<text:change text:change-id="ct2"/><text:change text:change-id="ct3"/> within thirty days of <text:span text:style-name="I">the</text:span><text:change text:change-id="ct4"/>.<office:annotation><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:35:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation></text:p>
   <text:p><text:change text:change-id="ct5"/><text:s/>must be sent<office:annotation office:name="c1"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:49:00</dc:date><text:p>Legal to review.</text:p></office:annotation> by<office:annotation-end office:name="c1"/> email and by registered mail.</text:p>
   <text:p>Disputes go first to mediation and<office:annotation office:name="c2"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:17:00</dc:date><text:p>Client asked for this.</text:p></office:annotation><text:change text:change-id="ct6"/><text:change text:change-id="ct7"/><office:annotation-end office:name="c2"/><text:change text:change-id="ct8"/> courts of Manhattan.<office:annotation><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:24:00</dc:date><text:p>Client asked for this.</text:p></office:annotation></text:p>
   <text:p>Neither<office:annotation office:name="c3"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:38:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation><text:change text:change-id="ct9"/> is liable for<office:annotation-end office:name="c3"/> delays caused by events beyond its control.</text:p>
   <text:p>This agreement is governed by the<office:annotation office:name="c4"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:06:00</dc:date><text:p>Agreed.</text:p></office:annotation><text:change text:change-id="ct10"/><text:change text:change-id="ct11"/> the State<office:annotation-end office:name="c4"/> of New<text:change text:change-id="ct12"/>.</text:p>
   <text:p>The supplier keeps title to the goods until they are<office:annotation office:name="c5"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:13:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> paid in full.<office:annotation-end office:name="c5"/></text:p>
   <text:p>The price includes packaging but excludes shipping<office:annotation office:name="c6"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:20:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> and <text:span text:style-name="B">taxes</text:span>.<office:annotation-end office:name="c6"/></text:p>
   <text:p><office:annotation office:name="c7"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:27:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation>Late payments <text:span text:style-name="I">carry</text:span> interest<office:annotation-end office:name="c7"/> at the statutory rate.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:34:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation></text:p>
   <text:p>The <text:span text:style-name="I">supplier</text:span> may subcontract only with the buyer's<office:annotation office:name="c8"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:41:00</dc:date><text:p>Check the defined term.</text:p></office:annotation> prior<office:annotation-end office:name="c8"/> consent.</text:p>
   <text:p><text:change text:change-id="ct13"/><text:s/>supplier shall deliver<text:change text:change-id="ct14"/> goods within thirty<text:change text:change-id="ct15"/> of<office:annotation office:name="c9"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:09:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> the<office:annotation-end office:name="c9"/> order.</text:p>
   <text:p>The<text:change text:change-id="ct16"/> includes packaging but excludes shipping<office:annotation office:name="c10"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:23:00</dc:date><text:p>Agreed.</text:p></office:annotation> <text:span text:style-name="I">and</text:span><office:annotation-end office:name="c10"/> taxes.</text:p>
   <text:p><text:change text:change-id="ct17"/><text:change text:change-id="ct18"/><text:s/>be<office:annotation office:name="c11"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:44:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> sent<office:annotation-end office:name="c11"/> by <text:span text:style-name="I">email</text:span> and by registered mail.</text:p>
   <text:p>Payment is due on<office:annotation office:name="c12"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:58:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation><text:change text:change-id="ct19"/> of<office:annotation-end office:name="c12"/> a correct <text:span text:style-name="I">invoice</text:span>.<office:annotation><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T04:05:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation></text:p>
   <text:p><text:change text:change-id="ct20"/><text:s/>party<office:annotation office:name="c13"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T04:47:00</dc:date><text:p>Check the defined term.</text:p></office:annotation><text:change text:change-id="ct21"/><text:change text:change-id="ct22"/> other<text:change text:change-id="ct23"/><office:annotation-end office:name="c13"/> confidential information<text:change text:change-id="ct24"/>.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T04:54:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation></text:p>
  </office:text>
 </office:body>
