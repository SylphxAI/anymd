   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:05:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:10:00</dc:date></office:change-info><text:p>heavy</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:15:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:20:00</dc:date></office:change-info><text:p>rd</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:format-change><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:25:00</dc:date></office:change-info></text:format-change></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:format-change><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-10-01T00:30:00</dc:date></office:change-info></text:format-change></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:35:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:40:00</dc:date></office:change-info><text:p>deleted</text:p></text:deletion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Formatting</text:h>
   <text:p>Bold inserted: <text:change-start text:change-id="ct1"/><text:span text:style-name="B">strong</text:span> and <text:span text:style-name="I">slanted</text:span><text:change-end text:change-id="ct1"/> text.</text:p>
   <text:p>Deleted bold: <text:change text:change-id="ct2"/><text:s/>text.</text:p>
   <text:p>Mid-word: con<text:change-start text:change-id="ct3"/><text:span text:style-name="B">tract</text:span><text:change-end text:change-id="ct3"/>ual and wo<text:change text:change-id="ct4"/>s.</text:p>
   <text:p>Formatting change only: <text:change-start text:change-id="ct5"/><text:span text:style-name="B">now bold</text:span><text:change-end text:change-id="ct5"/> and <text:change-start text:change-id="ct6"/><text:span text:style-name="I">now italic</text:span><text:change-end text:change-id="ct6"/>.</text:p>
   <text:p>Bold <text:span text:style-name="B">around <text:change-start text:change-id="ct7"/>an insertion<text:change-end text:change-id="ct7"/> inside</text:span> end.</text:p>
