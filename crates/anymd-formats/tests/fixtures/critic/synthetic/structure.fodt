:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:20:00</dc:date></office:change-info><text:p><text:s/>party</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct19" text:id="ct19"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:27:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="I">written</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct20" text:id="ct20"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T02:34:00</dc:date></office:change-info><text:p><text:s/>notice</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct21" text:id="ct21"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:41:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct22" text:id="ct22"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:48:00</dc:date></office:change-info><text:p><text:s/>shall</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct23" text:id="ct23"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:55:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct24" text:id="ct24"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:02:00</dc:date></office:change-info><text:p>goods</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct25" text:id="ct25"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:09:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct26" text:id="ct26"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:16:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct27" text:id="ct27"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:23:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct28" text:id="ct28"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:30:00</dc:date></office:change-info><text:p><text:s/>agreement</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct29" text:id="ct29"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:37:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="B">by</text:span></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct30" text:id="ct30"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:44:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct31" text:id="ct31"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:51:00</dc:date></office:change-info><text:p>New</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct32" text:id="ct32"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:58:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct33" text:id="ct33"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T04:19:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct34" text:id="ct34"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T04:26:00</dc:date></office:change-info><text:p><text:s/><text:span text:style-name="I">goods</text:span></text:p></text:deletion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Changes in headings, lists and footnotes</text:h>
   <text:p>Either party may<text:change-start text:change-id="ct1"/> at its own cost<text:change-end text:change-id="ct1"/> end this <text:change text:change-id="ct2"/><text:change-start text:change-id="ct3"/>vendor<text:change-end text:change-id="ct3"/><text:change text:change-id="ct4"/> ninety <text:change-start text:change-id="ct5"/></text:p><text:p><text:change-end text:change-id="ct5"/>days <text:span text:style-name="I">written</text:span> notice.</text:p>
   <text:p>The buyer shall return defective goods within<office:annotation office:name="c1"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:49:00</dc:date><text:p>Legal to review.</text:p></office:annotation> fourteen<text:change-start text:change-id="ct6"/> promptly<text:change-end text:change-id="ct6"/><office:annotation-end office:name="c1"/> days.</text:p>
   <text:p>The supplier may<text:change-start text:change-id="ct7"/> promptly<text:change-end text:change-id="ct7"/> <text:span text:style-name="B">subcontract</text:span> only <text:change text:change-id="ct8"/><text:change-start text:change-id="ct9"/>sixty<text:change-end text:change-id="ct9"/> the buyer's prior consent.</text:p>
   <text:list text:style-name="L1"><text:list-item><text:p>Either party may end this<text:change text:change-id="ct10"/> with ninety days written notice.</text:p></text:list-item><text:list-item><text:p>The supplier<text:change-start text:change-id="ct11"/> in full<text:change-end text:change-id="ct11"/> shall deliver<text:change-start text:change-id="ct12"/> in full<text:change-end text:change-id="ct12"/> the goods within thirty days of the order.</text:p></text:list-item><text:list-item><text:p>Neither party is liable for delays caused<text:change-start text:change-id="ct13"/> in full<text:change-end text:change-id="ct13"/> by events<text:change-start text:change-id="ct14"/> promptly<text:change-end text:change-id="ct14"/> beyond<text:change-start text:change-id="ct15"/> in full<text:change-end text:change-id="ct15"/> its control.</text:p></text:list-item><text:list-item><text:p>The warranty period is<office:annotation office:name="c2"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:06:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> twelve<text:change text:change-id="ct16"/> from<office:annotation-end office:name="c2"/> delivery.</text:p></text:list-item></text:list>
   <text:p>Either<text:change-start text:change-id="ct17"/> on a business day<text:change-end text:change-id="ct17"/><text:change text:change-id="ct18"/> may end this agreement with ninety days<text:change text:change-id="ct19"/><text:change text:change-id="ct20"/>.<text:change text:change-id="ct21"/> The <text:change-start text:change-id="ct27"/></text:p><text:p><text:change-end text:change-id="ct27"/>supplier<text:change text:change-id="ct22"/> deliver the<text:change-start text:change-id="ct23"/> in good faith<text:change-end text:change-id="ct23"/> <text:change text:change-id="ct24"/><text:change-start text:change-id="ct25"/>customer<text:change-end text:change-id="ct25"/> within thirty<text:change-start text:change-id="ct26"/> at its own cost<text:change-end text:change-id="ct26"/> days of the order.</text:p>
   <text:p>This<text:change text:change-id="ct28"/> is governed<text:change text:change-id="ct29"/> the <text:span text:style-name="I">laws</text:span> of<text:change-start text:change-id="ct30"/> at its own cost<text:change-end text:change-id="ct30"/> the State of<office:annotation office:name="c3"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T04:05:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation> <text:change text:change-id="ct31"/><text:change-start text:change-id="ct32"/>supplier<text:change-end text:change-id="ct32"/> <text:span text:style-name="I">York</text:span>.<office:annotation-end office:name="c3"/></text:p>
   <text:p>The price includes packaging but<office:annotation office:name="c4"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T04:12:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> <text:span text:style-name="B">excludes</text:span> shipping and taxes.<office:annotation-end office:name="c4"/><text:change text:change-id="ct33"/> The buyer shall return defective<text:change text:change-id="ct34"/> within fourteen days.</text:p>
  </office:text>
 </office:body>
