 <office:body>
  <office:text>
   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:05:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:10:00</dc:date></office:change-info><text:p>, page 4</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:15:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:20:00</dc:date></office:change-info><text:p><text:s/>goes away</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:30:00</dc:date></office:change-info><text:p></text:p><text:p></text:p></text:deletion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Notes</text:h>
   <text:p>A claim<text:note text:id="footnote1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>Source <text:change-start text:change-id="ct1"/>updated <text:change-end text:change-id="ct1"/>2024<text:change text:change-id="ct2"/>.</text:p></text:note-body></text:note> stands.</text:p>
   <text:p>An inserted note reference<text:change-start text:change-id="ct3"/><text:note text:id="footnote2" text:note-class="footnote"><text:note-citation>2</text:note-citation><text:note-body><text:p>Added later.</text:p></text:note-body></text:note><text:change-end text:change-id="ct3"/> here.</text:p>
   <text:p>A deleted sentence with a note<text:change text:change-id="ct4"/><text:note text:id="footnote3" text:note-class="footnote"><text:note-citation>3</text:note-citation><text:note-body><text:p>Still here.</text:p></text:note-body></text:note>.</text:p>
   <text:p>An endnote<text:note text:id="endnote1" text:note-class="endnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>End <office:annotation office:name="c1"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-10-01T00:25:00</dc:date><text:p>Comment inside an endnote</text:p></office:annotation>note<office:annotation-end office:name="c1"/> text.</text:p><text:p>Second paragraph<text:change text:change-id="ct5"/><text:s/>joined.</text:p></text:note-body></text:note> too.</text:p>
   <text:p>Comment <office:annotation office:name="c2"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-10-01T00:35:00</dc:date><text:p>Covers a note</text:p></office:annotation>around a note<text:note text:id="footnote4" text:note-class="footnote"><text:note-citation>4</text:note-citation><text:note-body><text:p>Inside a range.</text:p></text:note-body></text:note><office:annotation-end office:name="c2"/>.</text:p>
  </office:text>
