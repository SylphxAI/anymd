ffice:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T08:59:00</dc:date></office:change-info><text:p><text:s/>carry</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct53" text:id="ct53"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T09:06:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct54" text:id="ct54"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T09:13:00</dc:date></office:change-info><text:p><text:s/>the</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct55" text:id="ct55"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T09:27:00</dc:date></office:change-info><text:p><text:s/>signed</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct56" text:id="ct56"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T09:34:00</dc:date></office:change-info><text:p><text:s/>parties</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct57" text:id="ct57"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T09:41:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct58" text:id="ct58"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T09:48:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Heavy on everything</text:h>
   <text:p><text:change text:change-id="ct1"/><text:change-start text:change-id="ct2"/>notice<text:change-end text:change-id="ct2"/> warranty <text:change text:change-id="ct3"/><text:change-start text:change-id="ct4"/>supplier<text:change-end text:change-id="ct4"/> is <text:span text:style-name="B">twelve</text:span><office:annotation office:name="c1"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:35:00</dc:date><text:p>Legal to review.</text:p></office:annotation> months from delivery.<office:annotation-end office:name="c1"/></text:p>
   <text:p>Either party may end this agreement with ninety days<office:annotation office:name="c2"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:49:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> written notice<text:change-start text:change-id="ct5"/> without undue delay<text:change-end text:change-id="ct5"/>.<office:annotation-end office:name="c2"/></text:p>
   <table:table table:name="T1"><table:table-column table:number-columns-repeated="3"/><table:table-row><table:table-cell office:value-type="string"><text:p>Clause</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Change</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Status</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Late payments<text:change-start text:change-id="ct6"/> as reasonably required<text:change-end text:change-id="ct6"/><office:annotation office:name="c3"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:03:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> carry interest.<office:annotation-end office:name="c3"/></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Each <text:change text:change-id="ct7"/><text:change-start text:change-id="ct8"/>sixty<text:change-end text:change-id="ct8"/> keeps <text:change text:change-id="ct9"/><text:change-start text:change-id="ct10"/>supplier<text:change-end text:change-id="ct10"/>.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p><text:change text:change-id="ct11"/><text:change-start text:change-id="ct12"/>sixty<text:change-end text:change-id="ct12"/> warranty<office:annotation office:name="c4"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:52:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> period is.<office:annotation-end office:name="c4"/><office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:59:00</dc:date><text:p>Legal to review.</text:p></office:annotation></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>The <text:change text:change-id="ct13"/><text:change-start text:change-id="ct14"/>written<text:change-end text:change-id="ct14"/><office:annotation office:name="c5"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:27:00</dc:date><text:p>Agreed.</text:p></office:annotation> keeps<text:change-start text:change-id="ct15"/> promptly<text:change-end text:change-id="ct15"/> title.<office:annotation-end office:name="c5"/></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p><office:annotation office:name="c6"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:55:00</dc:date><text:p>Legal to review.</text:p></office:annotation>The supplier<text:change text:change-id="ct16"/><office:annotation-end office:name="c6"/> <text:change text:change-id="ct17"/><text:change-start text:change-id="ct18"/>vendor<text:change-end text:change-id="ct18"/>.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>The warranty period is.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Payment is due <text:change text:change-id="ct19"/><text:change-start text:change-id="ct20"/>written<text:change-end text:change-id="ct20"/>.<office:annotation><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:16:00</dc:date><text:p>Check the defined term.</text:p></office:annotation></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>The supplier<office:annotation office:name="c7"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:23:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> shall deliver.<office:annotation-end office:name="c7"/><office:annotation><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:30:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Late payments<office:annotation office:name="c8"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:37:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> carry interest.<office:annotation-end office:name="c8"/></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p><office:annotation office:name="c9"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:51:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation><text:change text:change-id="ct21"/><text:s/>buyer shall<office:annotation-end office:name="c9"/> return.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>The buyer<office:annotation office:name="c10"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T04:19:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation><text:change text:change-id="ct22"/> <text:change text:change-id="ct23"/><text:change-start text:change-id="ct24"/>supplier<text:change-end text:change-id="ct24"/>.<office:annotation-end office:name="c10"/></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Notices must be sent.</text:p></table:table-cell></table:table-row></table:table>
   <text:p><office:annotation office:name="c11"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T05:08:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation>Disputes<text:change-start text:change-id="ct25"/> unless agreed otherwise<text:change-end text:change-id="ct25"/> go<text:change-start text:change-id="ct26"/> as reasonably required<text:change-end text:change-id="ct26"/> <text:change text:change-id="ct27"/><text:change-start text:change-id="ct28"/>sixty<text:change-end text:change-id="ct28"/><office:annotation-end office:name="c11"/> to mediation and then to the courts of<text:change-start text:change-id="ct29"/> without undue delay<text:change-end text:change-id="ct29"/><text:change text:change-id="ct30"/>.</text:p>
   <text:list text:style-name="L1"><text:list-item><text:p>Each party keeps the<office:annotation office:name="c12"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T05:22:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> other<text:change text:change-id="ct31"/> confidential information<office:annotation-end office:name="c12"/> secret.</text:p></text:list-item><text:list-item><text:p>Either<text:change text:change-id="ct32"/> may end this agreement<text:change text:change-id="ct33"/><office:annotation office:name="c13"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T05:50:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> ninety<text:change-start text:change-id="ct34"/> as reasonably required<text:change-end text:change-id="ct34"/><office:annotation-end office:name="c13"/> days written notice.</text:p></text:list-item><text:list-item><text:p>Any<office:annotation office:name="c14"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T06:04:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> change to this agreement<office:annotation-end office:name="c14"/> must be<text:change text:change-id="ct35"/> writing and signed by both parties.</text:p></text:list-item><text:list-item><text:p>The price<text:change-start text:change-id="ct36"/> in full<text:change-end text:change-id="ct36"/> includes packaging but excludes shipping and taxes.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T06:18:00</dc:date><text:p>Agreed.</text:p></office:annotation></text:p></text:list-item></text:list>
   <text:p><text:change text:change-id="ct38"/><office:annotation-end office:name="c16"/>The warranty<text:change-start text:change-id="ct39"/> on a business day<text:change-end text:change-id="ct39"/> period is twelve months from delivery.</text:p>
   <text:p>Either party may<text:change text:change-id="ct40"/> this agreement with ninety days <text:change-start text:change-id="ct41"/></text:p><text:p><text:change-end text:change-id="ct41"/>written notice.<text:change text:change-id="ct42"/> The supplier may<text:change-start text:change-id="ct43"/> as reasonably required<text:change-end text:change-id="ct43"/><office:annotation office:name="c17"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T07:35:00</dc:date><text:p>Agreed.</text:p></office:annotation> subcontract only with<office:annotation-end office:name="c17"/> the buyer's prior<text:change text:change-id="ct44"/>.</text:p>
   <text:p>The buyer may inspect the goods<office:annotation office:name="c18"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T07:49:00</dc:date><text:p>Agreed.</text:p></office:annotation> <text:span text:style-name="B">before</text:span><office:annotation-end office:name="c18"/> <text:change-start text:change-id="ct45"/></text:p><text:p><text:change-end text:change-id="ct45"/><text:span text:style-name="I">accepting</text:span> them.</text:p>
   <text:p>The <text:span text:style-name="B">supplier</text:span> may subcontract only<text:change text:change-id="ct46"/> the<text:change-start text:change-id="ct47"/> unless agreed otherwise<text:change-end text:change-id="ct47"/><text:change text:change-id="ct48"/> prior consent.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T08:17:00</dc:date><text:p>Client asked for this.</text:p></office:annotation></text:p>
   <text:p>The price<office:annotation office:name="c19"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T08:38:00</dc:date><text:p>Client asked for this.</text:p></office:annotation> includes packaging but<text:change-start text:change-id="ct49"/> unless agreed otherwise<text:change-end text:change-id="ct49"/> excludes<office:annotation-end office:name="c19"/> shipping<text:change text:change-id="ct50"/> taxes.</text:p>
   <text:p><text:span text:style-name="I">Notices</text:span> must be sent by email <text:change-start text:change-id="ct51"/></text:p><text:p><text:change-end text:change-id="ct51"/>and by registered mail.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T08:52:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation></text:p>
   <text:p>Late payments<office:annotation office:name="c20"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T09:20:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation><text:change text:change-id="ct52"/> interest<office:annotation-end office:name="c20"/> at<text:change-start text:change-id="ct53"/> promptly<text:change-end text:change-id="ct53"/><text:change text:change-id="ct54"/> statutory rate.</text:p>
   <text:p>Any change <text:span text:style-name="B">to</text:span> this agreement <text:change-start text:change-id="ct57"/></text:p><text:p><text:change-end text:change-id="ct57"/>must be in writing <text:span text:style-name="I">and</text:span><text:change text:change-id="ct55"/> by both<text:change text:change-id="ct56"/>.</text:p>
   <text:p>This agreement<office:annotation office:name="c21"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T09:55:00</dc:date><text:p>Check the defined term.</text:p></office:annotation> is governed by<office:annotation-end office:name="c21"/> <text:span text:style-name="I">the</text:span> laws of the State of New York<text:change-start text:change-id="ct58"/> at its own cost<text:change-end text:change-id="ct58"/>.</text:p>
  </office:text>
