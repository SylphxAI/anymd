   <text:h text:outline-level="1">Changes and comments in tables</text:h>
   <text:p>The buyer shall return defective<text:change-start text:change-id="ct1"/> at its own cost<text:change-end text:change-id="ct1"/> goods <text:change text:change-id="ct2"/><text:change-start text:change-id="ct3"/>written<text:change-end text:change-id="ct3"/> fourteen days<text:change-start text:change-id="ct4"/> promptly<text:change-end text:change-id="ct4"/>.</text:p>
   <text:p>Notices must<text:change-start text:change-id="ct5"/> in good faith<text:change-end text:change-id="ct5"/> <text:span text:style-name="B">be</text:span> sent<text:change-start text:change-id="ct6"/> without undue delay<text:change-end text:change-id="ct6"/> by <text:span text:style-name="I">email</text:span> and by registered <text:span text:style-name="I">mail</text:span>.</text:p>
   <table:table table:name="T1"><table:table-column table:number-columns-repeated="3"/><table:table-row><table:table-cell office:value-type="string"><text:p>Clause</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Change</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Status</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>This agreement<text:change-start text:change-id="ct7"/> as reasonably required<text:change-end text:change-id="ct7"/><office:annotation office:name="c1"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:56:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> is governed.<office:annotation-end office:name="c1"/></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>The buyer shall return.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p><office:annotation office:name="c2"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:38:00</dc:date><text:p>Legal to review.</text:p></office:annotation><text:change text:change-id="ct8"/><text:change-start text:change-id="ct9"/>customer<text:change-end text:change-id="ct9"/><text:change text:change-id="ct10"/> first <text:change text:change-id="ct11"/><text:change-start text:change-id="ct12"/>vendor<text:change-end text:change-id="ct12"/>.<office:annotation-end office:name="c2"/></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Disputes go first <text:change text:change-id="ct13"/><text:change-start text:change-id="ct14"/>notice<text:change-end text:change-id="ct14"/>.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p><office:annotation office:name="c3"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:59:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation>Any change<office:annotation-end office:name="c3"/> to this.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Notices must<office:annotation office:name="c4"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:13:00</dc:date><text:p>Legal to review.</text:p></office:annotation> be<text:change-start text:change-id="ct15"/> on a business day<text:change-end text:change-id="ct15"/> sent.<office:annotation-end office:name="c4"/></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p><text:change text:change-id="ct16"/><text:s/>party<office:annotation office:name="c5"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:27:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation> is<office:annotation-end office:name="c5"/> liable.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Notices must be<text:change text:change-id="ct17"/>.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p><text:change text:change-id="ct18"/><text:s/>party<text:change text:change-id="ct19"/> end.</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Either<office:annotation office:name="c6"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:02:00</dc:date><text:p>Agreed.</text:p></office:annotation><text:change text:change-id="ct20"/> may end.<office:annotation-end office:name="c6"/></text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>This<text:change text:change-id="ct21"/> is governed.</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Disputes<text:change-start text:change-id="ct22"/> promptly<text:change-end text:change-id="ct22"/><office:annotation office:name="c7"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:37:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation> go<text:change text:change-id="ct23"/><office:annotation-end office:name="c7"/> to<text:change-start text:change-id="ct24"/> in good faith<text:change-end text:change-id="ct24"/>.</text:p></table:table-cell></table:table-row></table:table>
   <text:p>Payment<text:change-start text:change-id="ct25"/> at its own cost<text:change-end text:change-id="ct25"/> is due<text:change text:change-id="ct26"/> receipt of<text:change text:change-id="ct27"/> correct invoice.</text:p>
   <text:p>The warranty<office:annotation office:name="c8"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T04:26:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> period<text:change text:change-id="ct28"/><office:annotation-end office:name="c8"/> twelve months<text:change text:change-id="ct29"/><text:change text:change-id="ct30"/>.</text:p>
