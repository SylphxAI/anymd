   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:07:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:14:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:21:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:42:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:49:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:56:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:10:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:17:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct9" text:id="ct9"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:31:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct10" text:id="ct10"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:45:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct11" text:id="ct11"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T01:52:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct12" text:id="ct12"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:59:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:20:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct14" text:id="ct14"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:41:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct15" text:id="ct15"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:48:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct16" text:id="ct16"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:55:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct17" text:id="ct17"><text:insertion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:02:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct18" text:id="ct18"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:16:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct19" text:id="ct19"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:23:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct20" text:id="ct20"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:30:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct21" text:id="ct21"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:44:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct22" text:id="ct22"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T03:51:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Comments and additions</text:h>
   <text:p>Each<office:annotation office:name="c1"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:28:00</dc:date><text:p>Agreed.</text:p></office:annotation> party<text:change-start text:change-id="ct1"/> unless agreed otherwise<text:change-end text:change-id="ct1"/><office:annotation-end office:name="c1"/> keeps<text:change-start text:change-id="ct2"/> in full<text:change-end text:change-id="ct2"/> the other party's confidential information secret<text:change-start text:change-id="ct3"/> as reasonably required<text:change-end text:change-id="ct3"/>.</text:p>
   <text:p>The supplier may subcontract only with the buyer's prior consent.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T00:35:00</dc:date><text:p>Legal to review.</text:p></office:annotation><text:change-start text:change-id="ct4"/></text:p>
   <text:p><text:change-end text:change-id="ct4"/><text:change-start text:change-id="ct5"/>The warranty period is twelve months from delivery.<text:change-end text:change-id="ct5"/></text:p>
   <text:p>The warranty period is twelve months from delivery.</text:p>
   <text:p>The warranty period is<office:annotation office:name="c2"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:03:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> <text:span text:style-name="B">twelve</text:span><text:change-start text:change-id="ct6"/> as reasonably required<text:change-end text:change-id="ct6"/> months<office:annotation-end office:name="c2"/> from delivery.</text:p>
   <text:p>Payment<text:change-start text:change-id="ct7"/> without undue delay<text:change-end text:change-id="ct7"/><office:annotation office:name="c3"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:24:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> is due on receipt<office:annotation-end office:name="c3"/> of a correct invoice<text:change-start text:change-id="ct8"/> without undue delay<text:change-end text:change-id="ct8"/>.</text:p>
   <text:p>The supplier shall deliver the goods within thirty days of<office:annotation office:name="c4"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:38:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation> the <text:span text:style-name="B">order</text:span><text:change-start text:change-id="ct9"/> promptly<text:change-end text:change-id="ct9"/>.<office:annotation-end office:name="c4"/></text:p>
   <text:p>Late payments carry interest at the statutory rate.<text:change-start text:change-id="ct10"/></text:p>
   <text:p><text:change-end text:change-id="ct10"/><text:change-start text:change-id="ct11"/>Disputes go first to mediation and then to the courts of Manhattan.<text:change-end text:change-id="ct11"/></text:p>
   <text:p>Each party<office:annotation office:name="c5"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:06:00</dc:date><text:p>Is this consistent with the master agreement?</text:p></office:annotation> keeps<office:annotation-end office:name="c5"/> the other party's<text:change-start text:change-id="ct12"/> at its own cost<text:change-end text:change-id="ct12"/> confidential information secret.<office:annotation><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T02:13:00</dc:date><text:p>Check the defined term.</text:p></office:annotation></text:p>
   <text:p>Either party <text:span text:style-name="I">may</text:span> end <text:span text:style-name="I">this</text:span> agreement with ninety<text:change-start text:change-id="ct13"/> promptly<text:change-end text:change-id="ct13"/> days<office:annotation office:name="c6"><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T02:27:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation> written<office:annotation-end office:name="c6"/> notice.<office:annotation><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T02:34:00</dc:date><text:p>Please confirm with finance.</text:p></office:annotation></text:p>
   <text:p>The price includes packaging but <text:span text:style-name="B">excludes</text:span> shipping<text:change-start text:change-id="ct14"/> in good faith<text:change-end text:change-id="ct14"/> and taxes.<text:change-start text:change-id="ct15"/></text:p>
   <text:p><text:change-end text:change-id="ct15"/><text:change-start text:change-id="ct16"/>Disputes go first to mediation and then to the courts of Manhattan.<text:change-end text:change-id="ct16"/></text:p>
   <text:p>Disputes<text:change-start text:change-id="ct17"/> on a business day<text:change-end text:change-id="ct17"/> go first to mediation<office:annotation office:name="c7"><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T03:09:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation> and then<office:annotation-end office:name="c7"/> <text:span text:style-name="I">to</text:span> the courts of Manhattan.</text:p>
   <text:p>The supplier keeps title to the goods until<text:change-start text:change-id="ct18"/> as reasonably required<text:change-end text:change-id="ct18"/> they are paid in full.</text:p>
   <text:p>The supplier keeps<text:change-start text:change-id="ct19"/> in good faith<text:change-end text:change-id="ct19"/> title<text:change-start text:change-id="ct20"/> unless agreed otherwise<text:change-end text:change-id="ct20"/> to the goods until they are<office:annotation office:name="c8"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T03:37:00</dc:date><text:p>Why thirty and not sixty?</text:p></office:annotation> paid<office:annotation-end office:name="c8"/> in <text:span text:style-name="B">full</text:span>.</text:p>
   <text:p>Any change to this agreement must<office:annotation office:name="c9"><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T03:58:00</dc:date><text:p>Too broad, narrow it down.</text:p></office:annotation> be<text:change-start text:change-id="ct21"/> in full<text:change-end text:change-id="ct21"/> in writing<office:annotation-end office:name="c9"/> and<text:change-start text:change-id="ct22"/> in good faith<text:change-end text:change-id="ct22"/> signed by both parties.</text:p>
  </office:text>
 </office:body>
