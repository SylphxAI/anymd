   <text:p>עברית <text:change-start text:change-id="ct3"/>טקסט חדש<text:change-end text:change-id="ct3"/> ו<text:change text:change-id="ct4"/>. العربية <office:annotation office:name="c2"><dc:creator>Carla Duarte</dc:creator><dc:date>2026-10-01T00:30:00</dc:date><text:p>تعليق</text:p></office:annotation>نص<office:annotation-end office:name="c2"/>.</text:p>
