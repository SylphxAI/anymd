 <office:body>
  <office:text>
   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:07:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-09-01T00:14:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:21:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:28:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:35:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:42:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T00:49:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T00:56:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct9" text:id="ct9"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:03:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct10" text:id="ct10"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:10:00</dc:date></office:change-info><text:p/><text:p/></text:deletion></text:changed-region><text:changed-region xml:id="ct11" text:id="ct11"><text:insertion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-09-01T01:17:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct12" text:id="ct12"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-09-01T01:24:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-09-01T01:31:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Paragraph breaks inserted and deleted</text:h>
   <text:p>The price <text:span text:style-name="I">includes</text:span> packaging <text:change-start text:change-id="ct1"/></text:p><text:p><text:change-end text:change-id="ct1"/>but excludes shipping and taxes.<text:change text:change-id="ct2"/> Disputes go first to mediation and then <text:change-start text:change-id="ct3"/></text:p><text:p><text:change-end text:change-id="ct3"/><text:span text:style-name="I">to</text:span> the courts of <text:span text:style-name="I">Manhattan</text:span>.<text:change text:change-id="ct4"/> Any change to <text:span text:style-name="B">this</text:span> agreement must be in writing and signed by both parties.<text:change text:change-id="ct5"/> Late <text:span text:style-name="I">payments</text:span> carry interest at the <text:span text:style-name="I">statutory</text:span> rate.</text:p>
   <text:p>This agreement is governed by the laws of the State of New York.</text:p>
   <text:p>This agreement is governed by the laws <text:change-start text:change-id="ct6"/></text:p><text:p><text:change-end text:change-id="ct6"/>of the State of New York.<text:change text:change-id="ct7"/> Payment is due on receipt of a correct invoice.</text:p>
   <text:p>Either party may end this agreement <text:span text:style-name="I">with</text:span> ninety days written notice.</text:p>
   <text:p>Any change to this agreement must be in <text:span text:style-name="I">writing</text:span> and signed by both parties.<text:change text:change-id="ct8"/> Notices must be sent by email and by registered mail.<text:change text:change-id="ct9"/> The supplier shall deliver the goods <text:span text:style-name="B">within</text:span> thirty days of the order.<text:change text:change-id="ct10"/> Disputes go first to mediation and then to the courts of Manhattan.<text:change-start text:change-id="ct11"/></text:p>
   <text:p><text:change-end text:change-id="ct11"/><text:change-start text:change-id="ct12"/>The warranty period is twelve months from delivery.<text:change-end text:change-id="ct12"/></text:p>
   <text:p>The buyer <text:change-start text:change-id="ct13"/></text:p><text:p><text:change-end text:change-id="ct13"/>shall return defective goods within fourteen days.</text:p>
   <text:p>The supplier shall deliver the goods within thirty days of the order.</text:p>
  </office:text>
 </office:body>
