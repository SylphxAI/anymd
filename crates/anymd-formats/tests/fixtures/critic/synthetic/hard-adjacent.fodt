 <office:body>
  <office:text>
   <text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:05:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:10:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:deletion><office:change-info><dc:creator>Carla Duarte</dc:creator><dc:date>2026-10-01T00:15:00</dc:date></office:change-info><text:p>three</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:deletion><office:change-info><dc:creator>Dev Patel</dc:creator><dc:date>2026-10-01T00:20:00</dc:date></office:change-info><text:p>four</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:25:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:30:00</dc:date></office:change-info><text:p><text:s/>end of paragraph</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:deletion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:35:00</dc:date></office:change-info><text:p>old</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:insertion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:40:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct9" text:id="ct9"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:45:00</dc:date></office:change-info><text:p><text:s/>beta</text:p><text:p>gamma</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct10" text:id="ct10"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T00:50:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct11" text:id="ct11"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T00:55:00</dc:date></office:change-info><text:p>Cut one.</text:p><text:p>Cut two.</text:p><text:p>Cut three.</text:p><text:p></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct12" text:id="ct12"><text:deletion><office:change-info><dc:creator>Bo Chen</dc:creator><dc:date>2026-10-01T01:00:00</dc:date></office:change-info><text:p></text:p><text:p></text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:insertion><office:change-info><dc:creator>Ana Lima</dc:creator><dc:date>2026-10-01T01:05:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes>
   <text:h text:outline-level="1">Adjacent and spanning changes</text:h>
   <text:p>Back to back: <text:change-start text:change-id="ct1"/>one<text:change-end text:change-id="ct1"/><text:change-start text:change-id="ct2"/>two<text:change-end text:change-id="ct2"/><text:change text:change-id="ct3"/><text:change text:change-id="ct4"/>.</text:p>
   <text:p><text:change-start text:change-id="ct5"/>Start of paragraph <text:change-end text:change-id="ct5"/>middle<text:change text:change-id="ct6"/></text:p>
   <text:p>Replaced by two people: <text:change text:change-id="ct7"/><text:change-start text:change-id="ct8"/>new<text:change-end text:change-id="ct8"/>.</text:p>
   <text:p>Deletion across paragraphs: alpha<text:change text:change-id="ct9"/><text:s/>delta.</text:p>
   <text:p>Insertion across paragraphs: one<text:change-start text:change-id="ct10"/> two</text:p><text:p>three<text:change-end text:change-id="ct10"/> four.</text:p>
   <text:p>Before three cut paragraphs.</text:p>
   <text:p><text:change text:change-id="ct11"/>After them.</text:p>
   <text:p></text:p>
   <text:p>An empty paragraph above<text:change text:change-id="ct12"/><text:s/>and a joined one.</text:p>
   <text:p>Last<text:change-start text:change-id="ct13"/> words<text:change-end text:change-id="ct13"/></text:p>
