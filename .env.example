# Platform Auth binding (set all four; do not put credentials in this file).
SYLPHX_AUTH_URL=
SYLPHX_AUTH_ORGANIZATION_ID=
SYLPHX_AUTH_SECRET_KEY=
SYLPHX_PUBLISHABLE_KEY=

# Platform Secret Binding, server only. Missing credentials disable checkout.
SYLPHX_MONEY_API_KEY=
ANYMD_MONEY_MODE=
# Local/preview test tenant only. Set keys at runtime, never in source control.
ANYMD_MONEY_TEST_KEY=
ANYMD_MONEY_TEST_PARENT=
ANYMD_MONEY_TEST_URL=
ANYMD_MONEY_TEST_SECRET=
ANYMD_APP_ORIGIN=

# Optional public diagnostics settings.
ANYMD_OBS_PUBLISHABLE_KEY=
ANYMD_OBS_RELEASE=
ANYMD_OBS_CAPTURE_URL=

# Optional Playwright overrides.
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_CHROMIUM_PATH=
