[
  {
    "step": 1,
    "tool": "search",
    "description": "Find the phrase across a folder before reading whole documents.",
    "arguments": {
      "query": "warranty period",
      "sources": ["/absolute/path/to/specs"],
      "glob": "*.pdf",
      "max_results": 10,
      "context_chars": 200
    }
  },
  {
    "step": 2,
    "tool": "inspect",
    "description": "Render the page that holds the match as visual proof.",
    "arguments": {
      "operation": "render_page",
      "sources": [{ "path": "/absolute/path/to/specs/spec.pdf", "pages": [12] }],
      "include_image": true
    }
  }
]
