{
  "tool": "inspect",
  "description": "Crop one region of a page as citation evidence. Coordinates are PDF points from the bottom-left corner.",
  "arguments": {
    "operation": "extract_regions",
    "sources": [
      {
        "path": "/absolute/path/to/financial-report.pdf",
