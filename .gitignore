node_modules/
target/
bin/native/*
!bin/native/.gitkeep
build/
*.log
coverage/
.env*

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist

# Test Reports
test-report.junit.xml
.vercel

# Local page-cache artifacts from Rust text-index tests
**/.pdf-reader-mcp/
dist/pdf.worker*.mjs

# Staged native packaging outputs — never commit host binaries. The rename to
# citra-mcp-server (#626) left these patterns naming the old binary, so
# packages/citra-linux-x64-gnu/bin/citra-mcp-server was tracked anyway; that
# made every Release run fail at "Create release PR" because changesets/action
# commitMode=github-api refuses executable files.
bin/native/**/citra-mcp-server
bin/native/**/citra-mcp-server.exe
packages/**/bin/citra-mcp-server
packages/**/bin/citra-mcp-server.exe
# Pre-rename names, kept so any stale checkout stays ignored.
bin/native/**/pdf-reader-mcp-server
bin/native/**/pdf-reader-mcp-server.exe
bin/native/pdf-reader-mcp-server
packages/**/bin/pdf-reader-mcp-server
packages/**/bin/pdf-reader-mcp-server.exe

# same-host A/B working trees (never commit installs)
benchmark-artifacts/same-host-ab/ts-lkg-install/
benchmark-artifacts/same-host-ab/per-fixture/

# durable perf raw samples can be large; summaries live under verification/
verification/perf/raw/
*.tgz
