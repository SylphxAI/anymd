node_modules/
target/
bin/native/*
!bin/native/.gitkeep
build/
*.log
coverage/
.env*

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist

# Test Reports
test-report.junit.xml
.vercel

# Local page-cache artifacts from Rust text-index tests
**/.pdf-reader-mcp/
dist/

# Staged native packaging outputs — never commit host binaries. A stale
# pattern once let packages/*/bin/<binary> be tracked, which made every Release
# run fail at "Create release PR" because changesets/action commitMode=github-api
# refuses executable files. Keep one pattern per binary name ever shipped.
bin/native/**/anymd
bin/native/**/anymd.exe
packages/**/bin/anymd
packages/**/bin/anymd.exe
bin/native/**/citra-mcp-server
bin/native/**/citra-mcp-server.exe
packages/**/bin/citra-mcp-server
packages/**/bin/citra-mcp-server.exe
# Pre-rename names, kept so any stale checkout stays ignored.
bin/native/**/pdf-reader-mcp-server
bin/native/**/pdf-reader-mcp-server.exe
bin/native/pdf-reader-mcp-server
packages/**/bin/pdf-reader-mcp-server
packages/**/bin/pdf-reader-mcp-server.exe

*.tgz

# Browser playground WebAssembly (scripts/build-wasm.sh output)
docs/public/wasm/
benchmark-artifacts/
__pycache__/
