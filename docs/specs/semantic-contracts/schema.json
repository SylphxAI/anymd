{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sylphx.com/schemas/pdf-reader-mcp/semantic-contract-v1.json",
  "title": "PDF Reader MCP semantic capability contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "layer",
    "capability",
    "tools",
    "mustHold",
    "mayDiffer",
    "failClosed",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["draft", "active", "superseded"] },
    "layer": {
      "type": "string",
      "enum": ["interface", "semantic", "quality", "security"]
    },
    "capability": { "type": "string", "minLength": 3 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["read_pdf", "search_pdf", "pdf_compare", "pdf_evidence"] }
    },
    "matrixPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mustHold": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "mayDiffer": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failClosed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["interface-schema", "semantic-oracle", "task-eval", "security-bound", "manual-review"]
        },
        "suites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "relatedNonclaims": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
