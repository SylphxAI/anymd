{
  "name": "anymd-workspace",
  "private": true,
  "type": "module",
  "description": "anymd repository tools for the web app, Rust CLI and MCP server, and release workflows.",
  "homepage": "https://anymd.sylphx.com/",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "cargo build --release -p anymd",
    "test": "bun test",
    "test:cov": "bun test --coverage --timeout=30000",
    "test:rust": "cargo test",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:github-actions": "bash scripts/check-github-actions.sh",
    "check:versions": "bun scripts/set-version.ts --check && python3 scripts/check-vendored-crates.py",
    "check:copy": "bun scripts/render-copy.ts --check && python3 bench/leaderboard.py --check",
    "check:runner-profiles": "python3 scripts/check-public-runner-profiles.py .",
    "typecheck": "tsc --noEmit",
    "version:set": "bun scripts/set-version.ts",
    "render:copy": "bun scripts/render-copy.ts",
    "inspector": "npx @modelcontextprotocol/inspector node packages/anymd/bin/anymd.js mcp",
    "perf:installed-footprint": "bun scripts/perf/measure-installed-footprint.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:e2e": "bun run --cwd apps/web test:e2e",
    "docs:dev": "bun run web:dev",
    "docs:build": "bun run web:build",
    "docs:preview": "bun run --cwd apps/web start",
    "web:wasm": "bash scripts/build-wasm.sh"
  },
  "overrides": {
    "brace-expansion": "^5.0.13",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "markdown-it": "^15.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/web"
  ]
}
