{
  "name": "Anymd",
  "short_name": "Anymd",
  "description": "Convert local documents to Markdown in Document Studio.",
  "start_url": "/studio",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBFCF8",
  "theme_color": "#C3F53C",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
