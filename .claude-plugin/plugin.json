{
  "name": "anymd",
  "version": "8.5.17",
  "description": "Any file to clean Markdown for AI agents: PDF, Word, PowerPoint, Excel, EPUB, HTML and web pages, images (OCR), audio and video. Local Rust MCP server, no API key.",
  "author": {
    "name": "Sylphx",
    "url": "https://github.com/SylphxAI"
  },
  "homepage": "https://anymd.sylphx.com/",
  "repository": "https://github.com/SylphxAI/anymd",
  "license": "MIT",
  "keywords": [
    "mcp",
    "markdown",
    "pdf",
    "docx",
    "pptx",
    "xlsx",
    "epub",
    "ocr"
  ],
  "mcpServers": {
    "anymd": {
      "command": "npx",
      "args": [
        "-y",
        "@sylphx/anymd"
      ]
    }
  }
}
